
class Solution {
    public boolean isHappy(int n) {
        int sum;

        while (n != 1) {
            sum = 0;

            while (n > 0) {
                int digit = n % 10;
                sum += digit * digit;
                n /= 10;
            }

            n = sum;

            if (n == 4)
                return false;
        }

        return true;
    }
}
