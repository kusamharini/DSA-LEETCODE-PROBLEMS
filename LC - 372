class Solution {
    public int superPow(int a, int[] b) {
        a = a % 1337;
        return calculate(a, b, b.length - 1);
    }

    public int calculate(int a, int[] b, int index) {
        if (index < 0) {
            return 1;
        }

        int last = b[index];

        int part1 = pow(calculate(a, b, index - 1), 10);
        int part2 = pow(a, last);

        return (part1 * part2) % 1337;
    }

    public int pow(int a, int b) {
        int result = 1;

        a = a % 1337;

        while (b > 0) {
            result = (result * a) % 1337;
            b--;
        }

        return result;
    }
}
